    "demo": "tsx src/cli/demo.ts",
    "check": "tsx src/cli/check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@electric-sql/pglite": "0.5.16",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
