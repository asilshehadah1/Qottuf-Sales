{
  "name": "qottuf-sales-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Qottuf Business Development runtime, Phase 1: one Ledger, the Pipeline Engine, the gates and the first agents. Nothing is ever sent or published: every output ends as a draft in Asil's approval queue.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
